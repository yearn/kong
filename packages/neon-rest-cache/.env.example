# Set these explicitly for local development. The function does not load a parent
# .env file or use credentials from the existing web application.
DATABASE_URL=

# Optional same-branch read replica connection string for refresh source queries.
# Also set REST_CACHE_USE_SOURCE_REPLICA=true for local execution.
# When disabled or omitted, source queries use DATABASE_URL.
SOURCE_DATABASE_URL=
REST_CACHE_USE_SOURCE_REPLICA=false

# Required to call the authenticated /admin routes.
REST_CACHE_ADMIN_TOKEN=

# Set to "true" only to force a full historical timeseries reconciliation.
REST_CACHE_HISTORICAL_FULL_REFRESH=false
