# optional
# Emit bounded per-attempt RPC metrics over OTLP (requires OTEL_EXPORTER_OTLP_METRICS_ENDPOINT).
RPC_METRICS=
# Fraction of Sentry errors sent, 0-1 (default 1).
SENTRY_SAMPLE_RATE=
# OTLP/HTTP metrics endpoint and headers, e.g. Authorization=Basic%20<base64 user:pass>
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_SERVICE_NAME=kong
MQ_CONCURRENCY_MAX_PER_PROCESSOR=
MQ_CONCURRENCY_THRESHOLD=
GQL_ENABLE_CACHE=
GQL_DEFAULT_CACHE_MAX_AGE=
GITHUB_PERSONAL_ACCESS_TOKEN=
APE_TAX_VAULTS=
DEFAULT_START_DAYS_AGO=
# positive integer, default 7; lookback window for current apy/apr resolvers
CURRENT_PERFORMANCE_LOOKBACK_DAYS=
# Completed sparkline weeks cache lifetime in seconds, default 3600; 0 disables it.
SPARKLINE_CACHE_TTL_SECONDS=
# Optional database connection label (defaults to kong:ingest).
POSTGRES_APPLICATION_NAME=
LOG_STRIDE=
FULL_NODE_DEPTH=
RISK_CDN_URL=

# Webhook authentication
WEBHOOK_SECRET_S_SUBSCRIPTIONID=
WEBHOOK_SECRET_S_YVUSD_APR=
WEBHOOK_SECRET_S_KATANA_APR=

