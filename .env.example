PRICE_SERVICE_API_KEY=
PRICE_SERVICE_URL=https://prices.yearn.dev

# When true, chains listed in ENVIO_CHAINS read evm logs from envio entity tables instead of rpc getLogs.
USE_ENVIO=false
ENVIO_CHAINS=
ENVIO_GRAPHQL_URL=
ENVIO_HASURA_ADMIN_SECRET=
# JSON list of verified source histories. Unlisted contracts and earlier ranges use RPC.
# [{"chainId":1,"address":"0x...","abiPath":"yearn/3/vault","fromBlock":"12345678"}]
ENVIO_CONFIRMED_SOURCES=[]

REDIS_HOST=
REDIS_PORT=

# optional
MQ_CONCURRENCY_MAX_PER_PROCESSOR=
MQ_CONCURRENCY_THRESHOLD=
GQL_ENABLE_CACHE=
GQL_DEFAULT_CACHE_MAX_AGE=
GITHUB_PERSONAL_ACCESS_TOKEN=
APE_TAX_VAULTS=
DEFAULT_START_DAYS_AGO=
# positive integer, default 7; lookback window for current apy/apr resolvers
CURRENT_PERFORMANCE_LOOKBACK_DAYS=
LOG_STRIDE=
FULL_NODE_DEPTH=
RISK_CDN_URL=

# Webhook authentication
