# required
HTTP_ARCHIVE_1=
HTTP_ARCHIVE_10=
HTTP_ARCHIVE_137=
HTTP_ARCHIVE_250=
HTTP_ARCHIVE_8453=
HTTP_ARCHIVE_42161=
HTTP_ARCHIVE_4663=

HTTP_FULLNODE_1=
HTTP_FULLNODE_10=
HTTP_FULLNODE_137=
HTTP_FULLNODE_250=
HTTP_FULLNODE_8453=
HTTP_FULLNODE_42161=
HTTP_FULLNODE_4663=

PRICE_SERVICE_API_KEY=
PRICE_SERVICE_URL=https://prices.yearn.dev

REDIS_HOST=
REDIS_PORT=

# optional
# Emit MQ job inventory counters with bounded queue/job/chain labels.
MQ_INVENTORY=
# Emit bounded per-attempt RPC metrics over OTLP (requires OTEL_EXPORTER_OTLP_METRICS_ENDPOINT).
RPC_METRICS=
# Count exact HTTP JSON-RPC body bytes and PostgreSQL protocol write bytes (requires OTLP metrics endpoint).
# Node's undici is used for RPC attribution; HTTP headers, TLS framing, OTLP, Sentry, and non-Node fetch runtimes are not counted.
# PostgreSQL startup/auth handshake bytes are not counted; only writes after a pooled client connects.
OUTBOUND_BYTES_METRICS=
# Optional global JSON-RPC HTTP batching. Size 0 preserves singleton batches; opt-in sizes are 1-100; wait is 0-100ms.
# Values above 100 clamp to 100; non-numeric values use 0.
# Applies to all RPC providers.
RPC_BATCH_SIZE=
RPC_BATCH_WAIT_MS=
# OTLP metrics export cadence, milliseconds (default 60000; clamped to 10000-300000).
# OTEL_METRIC_EXPORT_INTERVAL wins; OTEL_METRIC_EXPORT_INTERVAL_MS is the legacy fallback.
OTEL_METRIC_EXPORT_INTERVAL=
OTEL_METRIC_EXPORT_INTERVAL_MS=
# Fraction of Sentry errors sent, 0-1 (default 1).
SENTRY_SAMPLE_RATE=
# OTLP/HTTP metrics endpoint and headers, e.g. Authorization=Basic%20<base64 user:pass>
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# Optional; only set to gzip after confirming the OTLP collector accepts compressed requests.
OTEL_EXPORTER_OTLP_METRICS_COMPRESSION=
OTEL_SERVICE_NAME=kong
MQ_CONCURRENCY_MAX_PER_PROCESSOR=
MQ_CONCURRENCY_THRESHOLD=
GQL_ENABLE_CACHE=
GQL_DEFAULT_CACHE_MAX_AGE=
GITHUB_PERSONAL_ACCESS_TOKEN=
APE_TAX_VAULTS=
DEFAULT_START_DAYS_AGO=
# positive integer, default 7; lookback window for current apy/apr resolvers
CURRENT_PERFORMANCE_LOOKBACK_DAYS=
# Completed sparkline weeks cache lifetime in seconds, default 3600; 0 disables it.
SPARKLINE_CACHE_TTL_SECONDS=
# Enable grouped TVL fanout only after every fanout/extract worker runs the grouped job version.
# Setting false stops new grouped enqueueing; persisted grouped jobs still need upgraded extract workers to drain.
TVL_GROUPED_JOBS=false
# Optional database connection label (defaults to kong:ingest).
POSTGRES_APPLICATION_NAME=
# Opt into named output statements only after verifying connection/pooler support; false uses unnamed statements.
OUTPUT_PREPARED_STATEMENTS=false
LOG_STRIDE=
FULL_NODE_DEPTH=
RISK_CDN_URL=

# Webhook authentication
WEBHOOK_SECRET_S_SUBSCRIPTIONID=
WEBHOOK_SECRET_S_YVUSD_APR=
WEBHOOK_SECRET_S_KATANA_APR=

# Monitor endpoints
MONITOR_API_KEY=
